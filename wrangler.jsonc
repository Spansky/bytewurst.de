{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Aufbau wie bei leon.cv: Die oberste Ebene ist die SICHERE VORGABE, Staging
	// auf workers.dev. Der Astro-Build schreibt die gewählte Umgebung nach
	// dist/server/wrangler.json (CLOUDFLARE_ENV beim Bauen), ein schlichtes
	// `wrangler deploy` liefert genau diese Datei aus. Ohne CLOUDFLARE_ENV zielt
	// der Build also auf Staging. Produktion braucht CLOUDFLARE_ENV=production
	// (npm run deploy:production). Bindungen und Variablen erben benannte
	// Umgebungen nicht, deshalb führt jede ihre eigenen auf.
	"name": "bytewurst-staging",
	"workers_dev": true,
	"preview_urls": false,
	// Wrangler legt Datenbank und Bucket beim ersten Deploy an. Nie auf die
	// Ressourcen der Produktion unten zeigen lassen.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bytewurst",
			"migrations_dir": "../../migrations",
			"database_id": "3e1b44ec-4b04-46c2-b3a7-a65917bf691f",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "bytewurst-media",
		},
	],
	// Sandboxed Plugins brauchen Worker Loader (bezahlter Workers-Tarif). Bei Bedarf:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Wartung und geplante Veröffentlichungen von EmDash (src/worker.ts)
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
	"env": {
		// Produktion: preview.bytewurst.de. Die Zone bytewurst.de muss dafür im
		// selben Cloudflare-Konto liegen (Custom Domain). Auf bytewurst.de selbst
		// läuft die Anwendung des Kunden, die bleibt unberührt.
		"production": {
			"name": "bytewurst",
			"routes": [
				{
					"pattern": "preview.bytewurst.de",
					"custom_domain": true,
				},
			],
			"workers_dev": false,
			"preview_urls": false,
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "bytewurst",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "bytewurst-media",
				},
			],
			"triggers": {
				"crons": [
					"* * * * *"
				],
			},
		},
	},
}