---
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons'

/*
  Font-Awesome-Symbol als schlichtes SVG. Die Pfade kommen aus
  @fortawesome/free-solid-svg-icons, ohne React-Komponente und ohne
  Laufzeit-Skript. Immer Dekoration: der Text daneben trägt die Bedeutung.
*/
interface Props {
  icon: IconDefinition
  class?: string
}

const { icon, class: klasse } = Astro.props
const [breite, hoehe, , , pfad] = icon.icon
const pfade = Array.isArray(pfad) ? pfad : [pfad]
---

<svg viewBox={`0 0 ${breite} ${hoehe}`} class={klasse} fill="currentColor" aria-hidden="true" focusable="false">
  {pfade.map((d) => <path d={d} />)}
</svg>
