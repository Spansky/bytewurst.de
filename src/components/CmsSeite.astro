---
import Bloecke from '../bloecke/Bloecke.astro'
import Base from '../layouts/Base.astro'
import type { CmsDaten } from '../lib/cms'

/* Eine Seite, deren Abschnitte aus EmDash kommen. Laden: lib/cms.ts im Frontmatter der Seite. */
type Props = CmsDaten

const { seite, entry, titel } = Astro.props
---

<Base seite={seite} titel={titel} inhalt={{ collection: 'pages', id: entry.data.id, slug: entry.id }}>
  <div {...entry.edit.inhalt}>
    <Bloecke value={entry.data.inhalt} />
  </div>
</Base>
