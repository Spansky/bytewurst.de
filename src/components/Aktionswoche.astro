---
import { aktionswoche as a, TAGE_LANG } from '../data/beispiele'
import { AKTION, aktionSvg, aktionText } from '../lib/diagramme'
import { prozent } from '../lib/format'
import Fenster from './Fenster.astro'

/*
  Aktionswoche: Besucher und Umsatz je Tag gegenüber der Vorwoche. Am
  Aktionstag springen die Besucher hoch, der Umsatz nicht. So zeigt es
  bytewurst.de für die Hackfleisch-Aktion, Tageswerte ausgedacht.
*/
interface Props {
  class?: string
}

const { class: klasse } = Astro.props
const t = a.aktionTag
---

<Fenster titel="Aktionswoche, Umsatz gegen Besucher" fuss="Gegenüber der Vorwoche, 100 = gleich viel. Beispielzahlen." class={klasse} data-aktionswoche="">
  <svg
    viewBox={`0 0 ${AKTION.B} ${AKTION.H}`}
    class="h-auto w-full"
    role="img"
    aria-label={`Hackfleisch-Aktion am Donnerstag: Besucher ${prozent(a.besucher[t] - 100)}, Umsatz ${prozent(a.umsatz[t] - 100)}`}
    set:html={aktionSvg(t)}
  />
  <div class="mt-3 grid grid-cols-6 gap-1.5" role="group" aria-label="Wochentag wählen">
    {
      a.tage.map((name, i) => (
        <button
          type="button"
          aria-pressed={i === t ? 'true' : 'false'}
          aria-label={`${TAGE_LANG[i]}${i === t ? ', Aktionstag' : ''}`}
          data-tag={i}
          class:list={[
            'min-h-11 rounded-lg border border-nacht-linie bg-nacht-hell font-mono text-sm font-semibold transition-colors hover:text-kreide aria-pressed:border-senf aria-pressed:bg-senf/10',
            i === t ? 'text-senf' : 'text-nebel aria-pressed:text-kreide',
          ]}
        >
          {name}
        </button>
      ))
    }
  </div>
  <div class="mt-3 flex flex-wrap items-center justify-between gap-3 text-sm">
    <div class="flex gap-4">
      <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="h-3 w-3 rounded-sm bg-kreide"></span> Besucher</span>
      <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="h-3 w-3 rounded-sm bg-prognose"></span> Umsatz</span>
    </div>
    <p class="ziffern font-mono" aria-live="polite" aria-atomic="true" data-ausgabe set:html={aktionText(t, TAGE_LANG[t])} />
  </div>
</Fenster>

<script>
  import { TAGE_LANG } from '../data/beispiele'
  import { aktionSvg, aktionText } from '../lib/diagramme'

  document.querySelectorAll<HTMLElement>('[data-aktionswoche]').forEach((fenster) => {
    const svg = fenster.querySelector('svg')!
    const ausgabe = fenster.querySelector('[data-ausgabe]')!
    const knoepfe = fenster.querySelectorAll<HTMLButtonElement>('button[data-tag]')
    knoepfe.forEach((k) =>
      k.addEventListener('click', () => {
        const tag = Number(k.dataset.tag)
        svg.innerHTML = aktionSvg(tag)
        ausgabe.innerHTML = aktionText(tag, TAGE_LANG[tag])
        knoepfe.forEach((x) => x.setAttribute('aria-pressed', String(x === k)))
      }),
    )
  })
</script>
