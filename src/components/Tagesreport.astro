---
import { firma } from '../data/betrieb'
import { tagesreport } from '../data/beispiele'
import { euro, euroGenau, ganz } from '../lib/format'

/*
  Die Morgenmail, so wie bytewurst.de sie zeigt: Kennzahlen von gestern, die
  fünf besten Produkte und die Stoßzeiten. Die Balken der Stoßzeiten lassen
  sich antippen. Zahlen aus src/data/beispiele.ts.
*/
interface Props {
  class?: string
}

const { class: klasse } = Astro.props
const max = Math.max(...tagesreport.stunden.map((s) => s.bons))
const spitze = tagesreport.stunden.find((s) => s.bons === max)!
---

<article
  aria-label="Beispiel einer Report-Mail von ByteWurst"
  data-tagesreport
  class:list={['overflow-hidden rounded-2xl bg-papier text-tinte shadow-[0_30px_60px_-25px_rgb(0_0_0/0.5)] ring-1 ring-black/5', klasse]}
>
  <div class="border-b border-fuge bg-fliese px-5 py-3.5 text-sm">
    <p>
      <span class="text-grau">Von:</span> <span class="font-semibold">ByteWurst</span>
      <span class="text-grau">&lt;{firma.reportAbsender}&gt;</span>
    </p>
    <p>
      <span class="text-grau">Betreff:</span> <span class="font-semibold">Dein Tagesreport, 04:00 Uhr</span>
    </p>
  </div>

  <div class="space-y-5 px-5 py-5">
    <p class="text-lg font-bold">Guten Morgen! Gestern auf einen Blick:</p>

    <dl class="grid grid-cols-3 gap-2 text-center">
      {
        [
          ['Umsatz', euro(tagesreport.umsatz)],
          ['Bons', ganz(tagesreport.bons)],
          ['Ø Bon', euroGenau(tagesreport.durchschnitt)],
        ].map(([was, wert]) => (
          <div class="rounded-lg bg-fliese px-1 py-2.5">
            <dt class="etikett text-grau">{was}</dt>
            <dd class="ziffern mt-0.5 font-mono text-[clamp(0.95rem,3.6vw,1.2rem)] font-bold">{wert}</dd>
          </div>
        ))
      }
    </dl>

    <div>
      <h3 class="etikett text-grau">Top-5-Produkte</h3>
      <ol class="mt-2 divide-y divide-fuge">
        {
          tagesreport.top.map((p, i) => (
            <li class="flex items-baseline gap-3 py-1.5">
              <span class="ziffern w-4 font-mono text-sm text-wurst-tief">{i + 1}</span>
              <span class="font-semibold">{p}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div>
      <div class="flex items-baseline justify-between gap-3">
        <h3 class="etikett text-grau">Stoßzeiten</h3>
        <p class="ziffern font-mono text-sm" aria-live="polite" aria-atomic="true" data-stunde>
          {spitze.uhr} Uhr: <strong>{spitze.bons} Bons</strong>
        </p>
      </div>
      <div class="mt-2 flex h-20 items-end gap-1" role="group" aria-label="Bons je Stunde, zum Antippen">
        {
          tagesreport.stunden.map((s) => (
            <button
              type="button"
              aria-label={`${s.uhr} Uhr, ${s.bons} Bons`}
              aria-pressed={s.uhr === spitze.uhr ? 'true' : 'false'}
              data-uhr={s.uhr}
              data-bons={s.bons}
              class="group flex h-full flex-1 items-end"
            >
              <span
                class="block w-full rounded-t-[3px] bg-wurst/75 transition-colors group-aria-pressed:bg-wurst-tief"
                style={`height: ${(s.bons / max) * 100}%`}
              />
            </button>
          ))
        }
      </div>
      <div class="ziffern mt-1 flex justify-between font-mono text-[0.6875rem] text-grau" aria-hidden="true">
        <span>7</span>
        <span>12</span>
        <span>18 Uhr</span>
      </div>
    </div>
  </div>
  <p class="border-t border-fuge px-5 py-2.5 text-xs text-grau">Beispielzahlen. Mit ByteWurst stehen hier deine echten.</p>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-tagesreport]').forEach((report) => {
    const anzeige = report.querySelector('[data-stunde]')!
    const balken = report.querySelectorAll<HTMLButtonElement>('button[data-uhr]')
    const waehlen = (gewaehlt: HTMLButtonElement) => {
      balken.forEach((b) => b.setAttribute('aria-pressed', String(b === gewaehlt)))
      anzeige.innerHTML = `${gewaehlt.dataset.uhr} Uhr: <strong>${gewaehlt.dataset.bons} Bons</strong>`
    }
    balken.forEach((b) => {
      b.addEventListener('pointerenter', () => waehlen(b))
      b.addEventListener('focus', () => waehlen(b))
      b.addEventListener('click', () => waehlen(b))
    })
  })
</script>
