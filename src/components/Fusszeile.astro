---
import { firma, KONZEPT } from '../data/betrieb'
import { JockJockCredit } from './jockjock-credit'
import Logo from './Logo.astro'

/*
  Fußzeile auf Nacht. Die Liste "Seiten" kommt aus dem EmDash-Menü "footer"
  (layouts/Base.astro). Der Jock&Jock-Credit ist die einzige React-Insel der
  Seite: eine gemeinsame Vorlage aller Projekte, die nicht abweichen soll.
*/
interface Props {
  seiten: { url: string; label: string; target?: string }[]
}

const { seiten } = Astro.props
---

<footer class="fokus-hell bg-nacht pb-[env(safe-area-inset-bottom)] text-kreide">
  <div class="rahmen grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href="/" aria-label="ByteWurst, zur Startseite" class="inline-block text-2xl">
        <Logo hell />
      </a>
      <p class="mt-5 max-w-sm text-nebel">
        Umsatzprognose und Reporting für Metzgereien, gemeinsam mit Metzgern entwickelt. Gerechnet wird nachts in der Cloud.
      </p>
      <p class="mt-6 text-sm text-nebel">
        Auch von ByteButchers:{' '}
        <a href={firma.schwester.url} class="text-kreide underline underline-offset-4 hover:text-senf">{firma.schwester.name}</a>, digitale Notizen
        für Handwerksbetriebe.
      </p>
    </div>

    <div class="md:col-span-4">
      <h2 class="etikett text-nebel">Reden wir über Wurst</h2>
      <ul class="mt-3">
        <li>
          <a href={`tel:${firma.telefonRoh}`} class="inline-flex min-h-11 items-center text-xl font-bold hover:text-senf">{firma.telefon}</a>
        </li>
        <li>
          <a href={`mailto:${firma.email}`} class="inline-flex min-h-11 items-center hover:text-senf">{firma.email}</a>
        </li>
        <li>
          <a
            href={firma.demo}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-11 items-center font-semibold text-senf underline underline-offset-4 hover:text-senf-hell"
          >
            Demo-Termin aussuchen
          </a>
        </li>
      </ul>
      <address class="mt-6 text-sm not-italic text-nebel">
        {firma.name}<br />
        {firma.strasse}, {firma.plz} {firma.ort}
      </address>
    </div>

    <nav aria-label="Seiten" class="md:col-span-3">
      <h2 class="etikett text-nebel">Seiten</h2>
      <ul class="mt-3">
        {
          seiten.map((s) => (
            <li>
              <a
                href={s.url}
                target={s.target}
                rel={s.target === '_blank' ? 'noopener' : undefined}
                class="inline-flex min-h-11 items-center text-kreide/90 underline-offset-4 transition-colors hover:text-senf hover:underline"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="rahmen flex flex-col items-center justify-between gap-8 border-t border-nacht-linie py-10 md:flex-row md:items-end">
    <div class="text-center text-sm text-nebel md:text-left">
      {
        KONZEPT ? (
          <p class="max-w-xl">
            Konzeptentwurf von Jock&amp;Jock für ByteWurst, kein offizieller Auftritt der {firma.name}. Die Fotos stammen von Unsplash, alle Zahlen in
            Diagrammen und Spielen sind Beispiele.
          </p>
        ) : (
          <p>© 2026 {firma.name}</p>
        )
      }
    </div>
    <JockJockCredit client:visible className="text-[0.9375rem] text-kreide" />
  </div>
</footer>
