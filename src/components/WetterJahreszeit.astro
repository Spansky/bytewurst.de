---
import { WETTER, WETTER_TEXT, wetterR, wetterSvg } from '../lib/diagramme'
import Fenster from './Fenster.astro'

/*
  Wetter oder Jahreszeit, nach dem Blogartikel auf bytewurst.de: Tag für Tag
  wirkt der Zusammenhang zwischen Temperatur und Grillgut schwach, zur Woche
  zusammengefasst stark. Die Korrelation wird aus den ausgedachten Daten
  echt ausgerechnet (src/data/beispiele.ts).
*/
interface Props {
  class?: string
}

const { class: klasse } = Astro.props
---

<Fenster
  titel="Umsatzreport, Grillgut und Temperatur"
  fuss="0 = kein Zusammenhang, 1 = vollständiger. Ein ausgedachtes Jahr, der Wert ist echt ausgerechnet."
  class={klasse}
  data-wetter=""
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="inline-flex rounded-full border border-nacht-linie p-1" role="group" aria-label="Zeitraster">
      {
        [
          [false, 'Tag für Tag'],
          [true, 'Woche für Woche'],
        ].map(([woche, name]) => (
          <button
            type="button"
            aria-pressed={woche ? 'false' : 'true'}
            data-woche={woche ? '1' : '0'}
            class="min-h-10 rounded-full px-4 text-sm font-semibold text-nebel transition-colors aria-pressed:bg-kreide aria-pressed:text-nacht"
          >
            {name}
          </button>
        ))
      }
    </div>
    <p class="ziffern font-mono text-sm" aria-live="polite" aria-atomic="true">
      Zusammenhang <span class="text-nebel">(Pearson-R)</span> <strong class="text-2xl text-senf" data-r>{wetterR(false)}</strong>
    </p>
  </div>

  <svg
    viewBox={`0 0 ${WETTER.B} ${WETTER.H}`}
    class="mt-4 h-auto w-full"
    role="img"
    aria-label="Temperatur und Absatz über ein Jahr, je Tag"
    set:html={wetterSvg(false)}
  />
  <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-sm">
    <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="h-1 w-5 rounded-full bg-prognose"></span> Grillgut verkauft</span>
    <span class="inline-flex items-center gap-2"><span aria-hidden="true" class="h-1 w-5 rounded-full bg-senf"></span> Temperatur</span>
  </div>
  <p class="mt-4 rounded-lg bg-nacht-hell px-4 py-3 text-[0.9375rem] leading-relaxed text-kreide/90" data-erklaerung>{WETTER_TEXT.tag}</p>
</Fenster>

<script>
  import { WETTER_TEXT, wetterR, wetterSvg } from '../lib/diagramme'

  document.querySelectorAll<HTMLElement>('[data-wetter]').forEach((fenster) => {
    const svg = fenster.querySelector('svg')!
    const knoepfe = fenster.querySelectorAll<HTMLButtonElement>('button[data-woche]')
    knoepfe.forEach((k) =>
      k.addEventListener('click', () => {
        const woche = k.dataset.woche === '1'
        svg.innerHTML = wetterSvg(woche)
        svg.setAttribute('aria-label', `Temperatur und Absatz über ein Jahr, ${woche ? 'je Woche' : 'je Tag'}`)
        fenster.querySelector('[data-r]')!.textContent = wetterR(woche)
        fenster.querySelector('[data-erklaerung]')!.textContent = woche ? WETTER_TEXT.woche : WETTER_TEXT.tag
        knoepfe.forEach((x) => x.setAttribute('aria-pressed', String(x === k)))
      }),
    )
  })
</script>
