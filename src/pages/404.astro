---
import Wursti from '../components/Wursti.astro'
import { seite } from '../data/seiten'
import Base from '../layouts/Base.astro'
---

<Base seite={seite('fehlt')}>
  <section aria-labelledby="fehlt-titel" class="fliesen">
    <div class="rahmen grid min-h-[70svh] items-center gap-12 py-16 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="ziffern font-mono text-lg font-bold text-wurst-tief">Fehler 404</p>
        <h1 id="fehlt-titel" class="titel mt-3 text-[clamp(3rem,9vw,7rem)]">Diese Seite ist leider aus.</h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-tinte/85">
          Hätten wir mal eine Prognose gemacht. Hier gibt es nichts mehr, aber an der Theke ist noch was da.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/" class="knopf knopf-wurst">Zur Startseite</a>
          <a href="/funktionen/" class="knopf knopf-linie text-tinte">Zu den Funktionen</a>
        </div>
      </div>
      <div class="md:col-span-5">
        <Wursti stimmung="staunt" folgen class="mx-auto h-auto w-full max-w-sm" />
      </div>
    </div>
  </section>
</Base>
