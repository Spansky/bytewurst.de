---
import { Blocks, defineBlockComponents } from 'emdash/ui'
import type { PageInhaltBlock } from '../../emdash-env'
import Abschnitt from './funktionen/Abschnitt.astro'
import Auslage from './funktionen/Auslage.astro'
import FunktionenKopf from './funktionen/Kopf.astro'
import Weg from './funktionen/Weg.astro'
import Fragen from './preise/Fragen.astro'
import PreiseKopf from './preise/Kopf.astro'
import Rechner from './preise/Rechner.astro'
import Tarife from './preise/Tarife.astro'
import Vergleich from './preise/Vergleich.astro'
import Schluss from './Schluss.astro'
import Einstieg from './start/Einstieg.astro'
import Einwaende from './start/Einwaende.astro'
import Frueher from './start/Frueher.astro'
import Kassenzettel from './start/Kassenzettel.astro'
import Nacht from './start/Nacht.astro'
import Pinnwand from './start/Pinnwand.astro'
import Planspiel from './start/Planspiel.astro'
import PreisTeaser from './start/PreisTeaser.astro'
import Wahrheitstest from './start/Wahrheitstest.astro'

/*
  Ordnet jedem Blocktyp aus EmDash seine Komponente zu. Neuer Blocktyp:
  in seed/seed.json unter blockTypes und allowedTypes eintragen, Komponente
  anlegen, hier verknüpfen.
*/
interface Props {
  value?: PageInhaltBlock[] | null
}

const { value } = Astro.props

const komponenten = defineBlockComponents<PageInhaltBlock>({
  einstieg: Einstieg,
  pinnwand: Pinnwand,
  planspiel: Planspiel,
  wahrheitstest: Wahrheitstest,
  nacht: Nacht,
  einwaende: Einwaende,
  frueher: Frueher,
  kassenzettel: Kassenzettel,
  preis_teaser: PreisTeaser,
  funktionen_kopf: FunktionenKopf,
  abschnitt: Abschnitt,
  auslage: Auslage,
  weg: Weg,
  preise_kopf: PreiseKopf,
  tarife: Tarife,
  rechner: Rechner,
  vergleich: Vergleich,
  fragen: Fragen,
  schluss: Schluss,
})
---

<Blocks value={value} components={komponenten} />
