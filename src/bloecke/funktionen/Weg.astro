---
import { einsetzen } from '../../lib/text'
import type { BlockProps } from '../typen'

/* Der Weg von der Demo bis zum ersten Report, nach Zeit statt nach Nummern */
type Props = BlockProps<'weg'>

const { value } = Astro.props
---

<section aria-labelledby="f-weg" class="bg-papier py-20 md:py-28">
  <div class="rahmen grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="f-weg" class="titel text-[clamp(2.3rem,4.8vw,3.9rem)]">{value.titel}</h2>
      {value.text && <p class="mt-6 text-lg leading-relaxed text-tinte/85">{einsetzen(value.text)}</p>}
    </div>
    <ol class="relative lg:col-span-7">
      <span aria-hidden="true" class="absolute top-3 bottom-3 left-[0.6875rem] w-[3px] rounded-full bg-fuge"></span>
      {
        value.schritte.map((w) => (
          <li class="relative pb-9 pl-12 last:pb-0" data-einblenden>
            <span
              aria-hidden="true"
              class="absolute top-1.5 left-0 h-[1.625rem] w-[1.625rem] rounded-full border-[5px] border-papier bg-wurst shadow-[0_0_0_2px_var(--color-wurst)]"
            />
            <p class="etikett text-wurst-tief">{w.wann}</p>
            <p class="mt-1 text-xl font-bold">{w.was}</p>
            {w.text && <p class="mt-1 leading-relaxed text-tinte/80">{einsetzen(w.text)}</p>}
          </li>
        ))
      }
    </ol>
  </div>
</section>
