---
import { faArrowRight } from '@fortawesome/free-solid-svg-icons/faArrowRight'
import Icon from '../../components/Icon.astro'
import Wursti from '../../components/Wursti.astro'
import { tarife } from '../../data/preise'
import { posten } from '../../data/start'
import { einsetzen } from '../../lib/text'
import type { BlockProps } from '../typen'

/*
  Alles, was in ByteWurst steckt, als Kassenbon. Er druckt sich, sobald er
  ins Bild kommt (data-drucken, index.css). Der Strichcode ist reine Deko.
*/
type Props = BlockProps<'kassenzettel'>

const { value } = Astro.props
const kostenlos = tarife[0]
---

<section aria-labelledby="posten-titel" class="fokus-papier relative bg-wurst py-20 text-papier md:py-28">
  <div class="rahmen grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 id="posten-titel" class="titel text-[clamp(2.5rem,5.6vw,4.6rem)]">{value.titel}</h2>
      {value.text && <p class="mt-6 text-lg leading-relaxed text-papier">{einsetzen(value.text)}</p>}
      <a
        href="/funktionen/"
        class="mt-8 inline-flex items-center gap-2 text-lg font-bold text-papier underline decoration-senf decoration-[3px] underline-offset-[6px] hover:decoration-papier"
      >
        {value.link || 'Alle Funktionen im Detail'}
        <Icon icon={faArrowRight} class="h-4 w-4" />
      </a>
      <Wursti folgen class="mt-12 hidden h-auto w-48 drop-shadow-[0_14px_12px_rgb(0_0_0/0.3)] lg:block" />
    </div>

    <div class="lg:col-span-7">
      <div class="bon-schatten mx-auto max-w-xl rotate-[0.6deg]">
        <div data-drucken class="bon px-5 text-[0.875rem] sm:px-8">
          <div class="text-center">
            <p class="text-lg font-bold tracking-[0.2em]">BYTEWURST</p>
            <p>ByteButchers GmbH, Stuttgart</p>
          </div>
          <div class="ziffern mt-4 flex justify-between text-grau">
            <span>Bon 0001</span>
            <span>04:00 Uhr</span>
          </div>
          <div class="bon-linie my-4"></div>
          <ul class="space-y-3.5">
            {
              posten.map((p) => (
                <li>
                  <div class="flex items-baseline gap-2">
                    <span class="shrink-0">1 x</span>
                    <span class="font-bold">{p.name}</span>
                    <span aria-hidden="true" class="min-w-4 flex-1 translate-y-[-0.25em] border-b border-dotted border-tinte/40" />
                    <span class="shrink-0">inkl.</span>
                  </div>
                  <p class="pl-[2.6ch] font-sans text-[0.8125rem] leading-snug text-grau">{p.text}</p>
                </li>
              ))
            }
          </ul>
          <div class="bon-linie my-4"></div>
          <div class="flex items-baseline justify-between gap-4 text-base font-bold">
            <span>SUMME</span>
            <span>je nach Umsatz</span>
          </div>
          <p class="mt-1 text-right text-[0.8125rem] text-grau">
            Zum Ausprobieren: {kostenlos.preis} ({kostenlos.leistungen.slice(0, 2).join(', ')})
          </p>
          <div class="bon-linie my-4"></div>
          <div
            aria-hidden="true"
            class="mx-auto h-12 w-4/5 [background-image:repeating-linear-gradient(90deg,var(--color-tinte)_0_2px,transparent_2px_4px,var(--color-tinte)_4px_7px,transparent_7px_9px,var(--color-tinte)_9px_10px,transparent_10px_13px)]"
          >
          </div>
          <p class="mt-4 text-center">Danke und bis morgen früh um vier!</p>
        </div>
      </div>
    </div>
  </div>
</section>
